{
  "_note": "Written to OpenWrt's ath79 layout for the Archer C7 v2 (ucidef_set_interfaces_lan_wan \"eth1\" \"eth0\"; ucidef_add_switch \"switch0\" \"0@eth1\" \"2:lan:2\" \"3:lan:3\" \"4:lan:4\" \"5:lan:1\"): the WAN on a NIC of its own beside the switch. Not captured from a device.",
  "model": {
    "id": "tplink,archer-c7-v2",
    "name": "TP-Link Archer C7 v2"
  },
  "switch": {
    "switch0": {
      "enable": true,
      "reset": true,
      "ports": [
        { "num": 0, "device": "eth1", "need_tag": false, "want_untag": false },
        { "num": 2, "role": "lan", "index": 2 },
        { "num": 3, "role": "lan", "index": 3 },
        { "num": 4, "role": "lan", "index": 4 },
        { "num": 5, "role": "lan", "index": 1 }
      ],
      "roles": [
        { "role": "lan", "ports": "2 3 4 5 0", "device": "eth1" }
      ]
    }
  },
  "network": {
    "lan": { "device": "eth1", "protocol": "static" },
    "wan": { "device": "eth0", "protocol": "dhcp" }
  }
}
