#!/bin/sh /etc/rc.common
# Keeps reading the devices for the web UI's Status pages (fast while someone
# has the UI open, once a minute otherwise), into RAM: /tmp/onc-collector,
# which the CGI answers from. It reads the intent afresh each time, so a
# save needs no restart.

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/openwrt-configurator collect /etc/onc/intent.json
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}
