#!/bin/sh
# Generate a root password for the router and AP (same on both).
# Prints one line to stdout. Save it in a password manager, then:
#   ssh -t root@10.0.0.1 passwd
#   ssh -t root@10.0.0.162 passwd
set -eu

if ! command -v openssl >/dev/null 2>&1; then
  echo "openssl is required" >&2
  exit 1
fi

# 24 random chars in 4 groups of 6. Hyphens are separators only (~143 bits).
raw=$(openssl rand -base64 32 | tr -d '/+=' | tr -d '\n' | cut -c1-24)
echo "${raw}" | sed 's/.\{6\}/&-/g' | sed 's/-$//'
echo
