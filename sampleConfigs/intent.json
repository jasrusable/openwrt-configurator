{
  "schema": 1,
  "system": {
    "name": "Home",
    "timezone": "Europe/Zurich",
    "country": "CH",
    "app_login": {
      "key": "~/.ssh/id_ed25519"
    }
  },
  "internet": {
    "lines": [
      {
        "id": "wan",
        "name": "Fibre",
        "type": "dhcp",
        "ipv6": {
          "enabled": true
        },
        "shaping": {
          "down_mbps": 950,
          "up_mbps": 950
        }
      }
    ]
  },
  "networks": [
    {
      "id": "lan",
      "name": "Home",
      "subnet": "10.0.0.0/24",
      "ipv6": true,
      "dhcp": {
        "pool_size": 250,
        "lease": "24h"
      },
      "access": {
        "internet": true,
        "networks": [
          "guest"
        ],
        "router": "full"
      }
    },
    {
      "id": "guest",
      "name": "Guests",
      "vlan": 20,
      "subnet": "10.0.20.0/24",
      "ipv6": false,
      "dhcp": {
        "pool_size": 100,
        "lease": "2h"
      },
      "access": {
        "internet": true,
        "networks": [],
        "router": "services"
      }
    }
  ],
  "firewall": {
    "rules": [
      {
        "name": "Guests may print",
        "from": "guest",
        "to": "lan",
        "protocol": "tcp",
        "action": "allow",
        "to_addresses": [
          "10.0.0.20"
        ],
        "ports": "631 9100"
      }
    ],
    "port_forwards": [
      {
        "name": "Game server",
        "enabled": true,
        "protocol": "udp",
        "reflection": true,
        "port": "27015",
        "to": {
          "address": "10.0.0.50"
        }
      }
    ]
  },
  "wifi": {
    "networks": [
      {
        "ssid": "Home",
        "network": "lan",
        "password": "change-me-please",
        "extra_passwords": [
          "change-me-too"
        ],
        "isolate_clients": false
      },
      {
        "ssid": "Home Guests",
        "network": "guest",
        "password": "welcome-guests",
        "isolate_clients": true
      }
    ]
  },
  "dns": {
    "upstream": {
      "type": "encrypted",
      "provider": "cloudflare"
    },
    "domain": "lan"
  },
  "hardware": [
    {
      "name": "home-router",
      "role": "router"
    },
    {
      "name": "home-ap-1",
      "role": "access-point",
      "radios": {
        "2g": {
          "channel": 11
        },
        "5g": {
          "channel": 36
        }
      }
    }
  ]
}
