{
  "schema": 4,
  "site": {
    "name": "Home",
    "timezone": "Europe/Zurich",
    "country": "CH"
  },
  "admin": {
    "ssh_key_path": "~/.ssh/id_ed25519"
  },
  "devices": [
    {
      "name": "home-router",
      "role": "router"
    },
    {
      "name": "home-ap-1",
      "role": "access-point",
      "wifi": {
        "channel": {
          "2g": 11,
          "5g": 36
        }
      }
    }
  ],
  "internet": {
    "connection": {
      "type": "dhcp"
    },
    "ipv6": true,
    "speed": {
      "down_mbps": 950,
      "up_mbps": 950
    }
  },
  "dns": {
    "over_https": "cloudflare",
    "local_domain": "lan"
  },
  "firewall": {
    "zones": [
      {
        "id": "lan",
        "networks": [
          "lan"
        ],
        "input": "accept",
        "forward": "accept",
        "output": "accept",
        "router_services": true
      },
      {
        "id": "guest",
        "networks": [
          "guest"
        ],
        "input": "reject",
        "forward": "reject",
        "output": "accept",
        "router_services": true
      }
    ],
    "forwardings": [
      {
        "from": "lan",
        "to": "wan"
      },
      {
        "from": "lan",
        "to": "guest"
      },
      {
        "from": "guest",
        "to": "wan"
      }
    ],
    "rules": [
      {
        "name": "Guests may print",
        "enabled": true,
        "from": "guest",
        "to": "lan",
        "destination_addresses": [
          "10.0.0.20"
        ],
        "protocol": "tcp",
        "ports": "631,9100",
        "family": "ipv4",
        "action": "accept"
      }
    ],
    "port_forwards": [
      {
        "name": "Game server",
        "enabled": true,
        "protocol": "udp",
        "external_port": "27015",
        "internal_address": "10.0.0.50",
        "reflection": true
      }
    ],
    "builtin_rules_off": []
  },
  "networks": [
    {
      "id": "lan",
      "name": "Home",
      "purpose": "home",
      "subnet": "10.0.0.0/24",
      "dhcp": {
        "size": 250,
        "lease": "24h"
      },
      "ipv6": true
    },
    {
      "id": "guest",
      "name": "Guests",
      "purpose": "guest",
      "vlan": 20,
      "subnet": "10.0.20.0/24",
      "dhcp": {
        "size": 100,
        "lease": "2h"
      },
      "ipv6": false
    }
  ],
  "wifi": [
    {
      "ssid": "Home",
      "network": "lan",
      "password": "change-me-please",
      "extra_passwords": [
        "change-me-too"
      ],
      "isolate_clients": false
    },
    {
      "ssid": "Home Guests",
      "network": "guest",
      "password": "welcome-guests",
      "isolate_clients": true
    }
  ]
}
