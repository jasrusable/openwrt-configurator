{
  "schema": 1,
  "site": {
    "name": "Home",
    "timezone": "Europe/Zurich",
    "country": "CH"
  },
  "admin": {
    "ssh_key_path": "~/.ssh/id_ed25519"
  },
  "hardware": [
    {
      "name": "home-router",
      "role": "router"
    },
    {
      "name": "home-ap-1",
      "role": "access-point",
      "wifi": {
        "channel": {
          "2g": 11,
          "5g": 36
        }
      }
    }
  ],
  "internet": {
    "connection": {
      "type": "dhcp"
    },
    "ipv6": true,
    "speed": {
      "down_mbps": 950,
      "up_mbps": 950
    }
  },
  "dns": {
    "upstream": {
      "type": "encrypted",
      "provider": "cloudflare"
    },
    "local_domain": "lan"
  },
  "wifi": [
    {
      "ssid": "Home",
      "network": "lan",
      "password": "change-me-please",
      "extra_passwords": [
        "change-me-too"
      ],
      "isolate_clients": false
    },
    {
      "ssid": "Home Guests",
      "network": "guest",
      "password": "welcome-guests",
      "isolate_clients": true
    }
  ],
  "networks": [
    {
      "id": "lan",
      "name": "Home",
      "subnet": "10.0.0.0/24",
      "dhcp": {
        "size": 250,
        "lease": "24h"
      },
      "ipv6": true,
      "access": {
        "internet": true,
        "networks": [
          "guest"
        ],
        "router": "full"
      }
    },
    {
      "id": "guest",
      "name": "Guests",
      "vlan": 20,
      "subnet": "10.0.20.0/24",
      "dhcp": {
        "size": 100,
        "lease": "2h"
      },
      "ipv6": false,
      "access": {
        "internet": true,
        "networks": [],
        "router": "services"
      }
    }
  ],
  "firewall": {
    "rules": [
      {
        "name": "Guests may print",
        "from": "guest",
        "to": "lan",
        "destination_addresses": [
          "10.0.0.20"
        ],
        "protocol": "tcp",
        "destination_port": "631 9100",
        "action": "allow"
      }
    ],
    "port_forwards": [
      {
        "name": "Game server",
        "enabled": true,
        "protocol": "udp",
        "external_port": "27015",
        "internal_address": "10.0.0.50",
        "reflection": true
      }
    ]
  }
}
