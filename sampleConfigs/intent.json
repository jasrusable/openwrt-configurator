{
  "schema": 2,
  "site": {
    "name": "Home",
    "timezone": "Europe/Zurich",
    "country": "CH"
  },
  "admin": {
    "ssh_key_path": "~/.ssh/id_ed25519"
  },
  "devices": [
    { "name": "home-router", "role": "router" },
    {
      "name": "home-ap-1",
      "role": "access-point",
      "wifi": { "channel": { "2g": 11, "5g": 36 } }
    }
  ],
  "internet": {
    "connection": { "type": "dhcp" },
    "ipv6": true,
    "speed": { "down_mbps": 950, "up_mbps": 950 }
  },
  "networks": [
    {
      "id": "lan",
      "name": "Home",
      "purpose": "home",
      "access": { "internet": true, "other_networks": true, "isolate_clients": false },
      "subnet": "10.0.0.0/24",
      "dhcp": { "size": 250, "lease": "24h" },
      "ipv6": true
    },
    {
      "id": "guest",
      "name": "Guests",
      "purpose": "guest",
      "access": { "internet": true, "other_networks": false, "isolate_clients": true },
      "vlan": 20,
      "subnet": "10.0.20.0/24",
      "dhcp": { "size": 100, "lease": "2h" },
      "ipv6": false
    }
  ],
  "wifi": [
    {
      "ssid": "Home",
      "network": "lan",
      "password": "change-me-please",
      "extra_passwords": ["change-me-too"]
    },
    { "ssid": "Home Guests", "network": "guest", "password": "welcome-guests" }
  ],
  "dns": {
    "over_https": "cloudflare",
    "local_domain": "lan"
  }
}
